# Base de datos (PostGIS en Docker, ver infra/docker-compose.yml).
# Puerto 5433 para no chocar con un PostgreSQL local en 5432.
DATABASE_URL=postgres://pc:pc_dev_password@localhost:5433/puntos_carga

# API
API_PORT=3000

# Open Charge Map (opcional). Clave gratuita en https://openchargemap.org/site/develop/api
OCM_API_KEY=

# Carpeta donde la ingesta guarda los ficheros descargados
INGEST_CACHE_DIR=data/cache

# Planificador de rutas y búsqueda de lugares. Por defecto, servidores públicos de OSRM y Photon
# (solo para desarrollo/uso moderado). En producción: instancias propias.
ROUTING_URL=https://router.project-osrm.org
GEOCODER_URL=https://photon.komoot.io

# Sal para el hash del id anónimo de dispositivo (avisos de la comunidad). Cambiar en producción.
DEVICE_HASH_SALT=cambia-esta-sal
