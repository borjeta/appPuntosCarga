# Copia este fichero a .env.local y rellénalo. Las variables EXPO_PUBLIC_* se incluyen en la app:
# no pongas aquí nada secreto (la clave "publishable" de Supabase sí es pública por diseño).

# Ficheros de datos (GitHub Pages en producción). En desarrollo, por defecto: http://<tu PC>:8090
# EXPO_PUBLIC_DATA_URL=https://<usuario>.github.io/<repositorio>

# Supabase (comunidad). Sin esto la app funciona igual, con la comunidad desactivada.
# Local: valores de `npx supabase status`. Producción: Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: servicios propios de rutas y lugares (por defecto, OSRM y Photon públicos)
# EXPO_PUBLIC_ROUTING_URL=
# EXPO_PUBLIC_GEOCODER_URL=

# Opcional: usar la API NestJS en vez del modo sin servidor
# EXPO_PUBLIC_API_URL=http://localhost:3000
