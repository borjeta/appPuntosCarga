# Copia este fichero a .env.local y rellénalo. Las variables EXPO_PUBLIC_* se incluyen en la app:
# no pongas aquí nada secreto (la clave "publishable" de Supabase sí es pública por diseño).

# Ficheros de datos. Por defecto: https://borjeta.github.io/appPuntosCarga (GitHub Pages).
# "local" usa los generados en tu PC con `npm run data:export` + `npm run data:serve` (puerto 8090).
# EXPO_PUBLIC_DATA_URL=local

# Supabase (comunidad). Por defecto, el proyecto de producción (mfbauxiyuqpfvmydedhk).
# Para el Supabase local: valores de `npx supabase status`.
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: servicios propios de rutas y lugares (por defecto, OSRM y Photon públicos)
# EXPO_PUBLIC_ROUTING_URL=
# EXPO_PUBLIC_GEOCODER_URL=

# Opcional: usar la API NestJS en vez del modo sin servidor
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Premium (RevenueCat): clave pública de iOS/Android. Sin ella no se ofrecen compras.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# Anuncios (AdMob): unidad de banner. Sin ella se muestran anuncios de PRUEBA de Google.
# EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-xxx/yyy
# EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-xxx/yyy
# IDs de aplicación de AdMob (los lee app.config.ts al compilar; sin ellos, IDs de prueba):
# ADMOB_IOS_APP_ID=ca-app-pub-xxx~zzz
# ADMOB_ANDROID_APP_ID=ca-app-pub-xxx~zzz
